# Copy to .env for docker compose, or export before `make demo`.
# Every variable has a safe local default in configs/gateway.yaml.

# Public listener port (Render sets this).
PORT=8080
# Admin listener for /metrics, /healthz, /readyz.
ADMIN_LISTEN=:9090
LOG_LEVEL=info

# HS256 secret for the "customers" JWT provider (>= 32 bytes). Also read by cmd/devtoken.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Plain API key for the "pathao-courier" partner.
PARTNER_API_KEY=demo-partner-key

# Rate limiting: memory (per replica) or redis (shared across replicas).
RATE_LIMIT_BACKEND=memory
REDIS_ADDR=

# Upstream targets.
CATALOG_1_URL=http://127.0.0.1:9001
CATALOG_2_URL=http://127.0.0.1:9002
ORDERS_URL=http://127.0.0.1:9003

# Seconds of failing /readyz before the listener closes on SIGTERM.
GATEWAY_DRAIN_DELAY=0s
